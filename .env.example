# Cloud / standalone API (REST over HTTP). This is the default transport.
# Set API_TRANSPORT=ipc only for legacy local unix-socket embedding.
API_TRANSPORT=rest
# Listen address. Cloud platforms often inject PORT instead — that is honored when API_ADDR is unset.
API_ADDR=:8088
# PORT=8088

# JWT signing secret (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# Encrypts developer-settings secrets (SMTP password, API keys). Any length is accepted;
# non-standard lengths are hashed to a 32-byte AES key.
# ENCRYPTION_KEY=change-me-to-a-long-random-string

# Database — PostgreSQL (recommended for cloud/Docker) or SQLite (local dev)
#
# PostgreSQL (used when DATABASE_URL or POSTGRES_HOST is set):
DATABASE_URL=postgres://truerp:truerp@localhost:5432/truerp?sslmode=disable
# Or build the URL from components:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=truerp
# POSTGRES_PASSWORD=truerp
# POSTGRES_DB=truerp
# POSTGRES_SSLMODE=disable
#
# SQLite (default when no PostgreSQL settings are set):
# DATABASE_PATH=data/truerp.db
# Docker image default without DATABASE_URL: /app/data/truerp.db
#
# Migrate live SQLite → PostgreSQL (stop backend first, then from backend/):
#   export DATABASE_URL=postgres://truerp:truerp@localhost:5432/truerp?sslmode=disable
#   ./scripts/migrate-sqlite-to-postgres.sh
# Or manually: go run ./cmd/migrate-sqlite-to-postgres -all -sqlite data/truerp.db -postgres "$DATABASE_URL"

# Docker (from repo root):
#   cp backend/.env.example backend/.env   # then edit secrets
#   docker compose -f backend/docker-compose.yml up --build
# Optional host port: API_PUBLISH_PORT=8088

# Default super admin (created on startup if this email is not registered yet)
SUPER_ADMIN_EMAIL=admin@truerp.local
SUPER_ADMIN_PASSWORD=change-me-in-production
SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_PHONE=

# Frontend URL for password-reset emails.
# Desktop clients are local; use a support/web URL users can open in a browser, or omit SMTP.
FRONTEND_URL=https://app.example.com

# SMTP (required to send password reset emails; without this, reset links are logged to the server console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=TruERP

# Storage — prefer S3/R2 in cloud so desktop clients get absolute HTTPS asset URLs.
# STORAGE_TYPE=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_BASE_URL=https://your-bucket-name.s3.us-east-1.amazonaws.com
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Cloudflare R2 (S3-compatible)
# STORAGE_TYPE=cloudflare_r2
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET=your-bucket-name
# R2_BASE_URL=https://your-bucket-name.your-account-id.r2.cloudflarestorage.com

# Local disk storage (dev / single-node only). Use an absolute PUBLIC base URL in cloud.
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=uploads
# Docker image default: /app/uploads
# Example for cloud behind a public API host:
# LOCAL_STORAGE_BASE_URL=https://api.example.com/uploads
LOCAL_STORAGE_BASE_URL=/uploads
